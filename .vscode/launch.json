{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: runstarnet test_sky.tiff",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/runstarnet/runstarnet.py",
            "console": "integratedTerminal",
            "args": ["test_sky.tif"]
        },
        {
            "name": "Python Debugger: runstarnet --no-interactive",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/runstarnet/runstarnet.py",
            "console": "integratedTerminal",
            "args": ["--no-interactive", "test_sky.tif"]
        },
        {
            "name": "Python Debugger: runstarnet --quiet",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/runstarnet/runstarnet.py",
            "console": "integratedTerminal",
            "args": ["--quiet", "test_sky.tif"]
        },
        {
            "name": "Python Debugger: runstarnet --quiet --no-interactive",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/runstarnet/runstarnet.py",
            "console": "integratedTerminal",
            "args": ["-q", "--no-interactive", "test_sky.tif"]
        },
        {
            "name": "Python Debugger: runstarnet --help",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/runstarnet/runstarnet.py",
            "console": "integratedTerminal",
            "args": ["-h"]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}